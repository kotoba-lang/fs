        {:git/url "https://github.com/kotoba-lang/fs-ifilesystem.git"
         :git/sha "86c46518b60ff14af1001c4a2ced210608fb40c7"}
        io.github.kotoba-lang/fs-absolute
        {:git/url "https://github.com/kotoba-lang/fs-absolute.git"
         :git/sha "cc51c7f1c4cc069c912972b28ad34ba5d6ec810d"}
        io.github.kotoba-lang/fs-basename
        {:git/url "https://github.com/kotoba-lang/fs-basename.git"
         :git/sha "80d5fbf17730410d12446ce95ecb84dc1630b606"}
        io.github.kotoba-lang/fs-copy
        {:git/url "https://github.com/kotoba-lang/fs-copy.git"
         :git/sha "8cdf5da92142a7061d24ff2379da08e0fa98eaba"}
