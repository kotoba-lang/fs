        {:git/url "https://github.com/kotoba-lang/fs-split.git"
         :git/sha "24f2b92005aa216b45ea4f3bcf11ec2e7be60c1c"}
        io.github.kotoba-lang/fs-utf8-bytes
        {:git/url "https://github.com/kotoba-lang/fs-utf8-bytes.git"
         :git/sha "56e889d2c93babd1837fd384d7c5d5e4dea83329"}
