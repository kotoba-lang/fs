        {:git/url "https://github.com/kotoba-lang/fs-eventual-error-type.git"
         :git/sha "34ed6aa3badfcb8d234e737487b2341218a923d2"}
        io.github.kotoba-lang/fs-ext
        {:git/url "https://github.com/kotoba-lang/fs-ext.git"
         :git/sha "67f7f59fdd544c6f5d712df5e028c741336d5ddf"}
        io.github.kotoba-lang/fs-join
        {:git/url "https://github.com/kotoba-lang/fs-join.git"
         :git/sha "48702268021e25cc55e54585a60311ff24431167"}
        io.github.kotoba-lang/fs-mem-filesystem
