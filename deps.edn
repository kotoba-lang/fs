{:paths ["src"]
 :version "0.1.0"
 ;; kotoba-lang/fs — Layer 3 (I/O) of the kotoba foundational stdlib.
 ;; Pure path ops + an IFilesystem protocol (HOST-INJECTED): the cell never
 ;; touches the OS directly, only a granted filesystem handle. Zero third-party
 ;; runtime deps; .cljc. See ADR-kotoba-lang-foundational-stdlib.md.
 :deps {
        io.github.kotoba-lang/fs-iasync-filesystem
        {:git/url "https://github.com/kotoba-lang/fs-iasync-filesystem.git"
         :git/sha "c9596d6fa889a3ca2f6478b1075fcf9bda42720f"}
